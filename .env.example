# ─── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/eduanalytics

# ─── Auth ─────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-chars

# ─── Server ───────────────────────────────────────────────
PORT=3001
NODE_ENV=production
LOG_LEVEL=info

# ─── App URL (used in password reset email links) ─────────
# Set to your Vercel frontend URL in production
APP_URL=https://your-vercel-app.vercel.app

# ─── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins
# For Vercel+Render split: set to your Vercel app URL
ALLOWED_ORIGINS=https://your-vercel-app.vercel.app

# ─── Password Reset — SMTP (optional) ────────────────────
# If not set, reset links are returned directly in the API response (demo mode)
# Works with any SMTP provider: Gmail, Resend, SendGrid, Mailgun, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="EduAnalytics" <no-reply@yourdomain.com>

# ─── Seed protection ─────────────────────────────────────
SEED_SECRET=change-this-to-a-random-secret

# ─── Monitoring — Sentry ──────────────────────────────────
# Backend DSN (obtain from sentry.io > your-project > SDK Setup)
SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX
# Frontend (Vite) — must be prefixed with VITE_
VITE_SENTRY_DSN=https://xxx@oXXX.ingest.sentry.io/XXX

# ─── Analytics — PostHog ──────────────────────────────────
VITE_POSTHOG_KEY=phc_XXXXXXXXXX
VITE_POSTHOG_HOST=https://app.posthog.com

# ─── App metadata (injected into frontend build) ──────────
VITE_APP_VERSION=1.0.0
VITE_APP_NAME=EduAnalytics
